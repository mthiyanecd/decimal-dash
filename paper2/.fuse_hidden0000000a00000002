/* mixed-unit ordering (capacity) */
TYPES.ordCap={skill:'s6',gen(){
  const base=[[ri(2,8)*100+ri(1,9)*10,'mℓ',1],[ri(2,9),'ℓ',1000],[ri(11,89),'ℓ',100],[ri(2,7),'ℓ',250]];
  /* build 4 display/value pairs: X mℓ, a,b ℓ, c,d ℓ, fraction ℓ */
  const items=[];
  items.push({d:base[0][0]+' mℓ',v:base[0][0]});
  const l1=ri(11,89); items.push({d:trimz(fmt(l1,1))+' ℓ',v:l1*100});
  const l2=ri(101,899); items.push({d:trimz(fmt(l2,2))+' ℓ',v:l2*10});
  const fr3=pick([[1,4,250],[1,2,500],[3,4,750]]); items.push({d:fr3[0]+'/'+fr3[1]+' ℓ',v:fr3[2]});
  const vals=items.map(i=>i.v); if(new Set(vals).size<4) return TYPES.ordCap.gen();
  const asc=items.slice().sort((a,b)=>a.v-b.v).map(i=>i.d).join(' ; ');
  const desc=items.slice().sort((a,b)=>b.v-a.v).map(i=>i.d).join(' ; ');
  let wrong2=shuffle(items.slice()).map(i=>i.d).join(' ; ');
  if(wrong2===asc||wrong2===desc) wrong2=items.map(i=>i.d).reverse().join(' ; ');
  if(wrong2===asc||wrong2===desc) return TYPES.ordCap.gen();
  return {type:'ordCap',skill:'s6',input:'choice',choices:shuffle([asc,desc,wrong2]),ans:asc,marks:2,diff:3,src:'Book p.122 Q2',
    prompt:`Which list shows these capacities in <b>ascending order</b> (smallest to largest)?<br><b>${shuffle(items.map(i=>i.d)).join(' &nbsp; · &nbsp; ')}</b>`,
    sol:`Change everything to mℓ first: ${items.slice().sort((a,b)=>a.v-b.v).map(i=>i.d+' = '+i.v+' mℓ').join(' ; ')}. Ascending: <b>${asc}</b>.`,
    hints:['Convert ALL of them to millilitres before comparing.','1 ℓ = 1000 mℓ; ¼ ℓ = 250 mℓ; ¾ ℓ = 750 mℓ.'],pencil:true};
}};
/* mixed-unit ordering (mass) */
TYPES.ordMass={skill:'s7',gen(){
  const items=[];
  items.push({d:(ri(2,8)*100+ri(1,9)*10)+' g',v:0}); items[0].v=parseInt(items[0].d);
