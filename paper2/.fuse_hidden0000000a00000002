/* two-row cube stacks */
const STACK2=[
 {back:[2,1,0],front:[1,2,1],count:7,fv:[2,2,1],top:[[0,0],[1,0],[2,0],[0,1],[1,1]]},
 {back:[1,1,1],front:[2,1,0],count:6,fv:[2,1,1],top:[[0,0],[1,0],[0,1],[1,1],[2,1]]},
 {back:[0,2,1],front:[1,1,1],count:6,fv:[1,2,1],top:[[0,0],[1,0],[2,0],[1,1],[2,1]]},
 {back:[2,0,1],front:[1,1,2],count:7,fv:[2,1,2],top:[[0,0],[1,0],[2,0],[0,1],[2,1]]}];
function stack2SVG(p){ const s=30,d=14; let out='';
  for(let c=0;c<p.back.length;c++) for(let h=0;h<p.back[c];h++) out+=cubeAt(15+c*s+d,120-s-h*s-d,s);
  for(let c=0;c<p.front.length;c++) for(let h=0;h<p.front[c];h++) out+=cubeAt(15+c*s,120-s-h*s,s);
  return svgWrap(15+p.front.length*s+40,150,out,210);}
TYPES.cubeCount2={skill:'s4',gen(fx){
  const i=(fx&&fx.i!=null)?fx.i:ri(0,STACK2.length-1); const p=STACK2[i];
  return {type:'cubeCount2',skill:'s4',input:'text',ans:String(p.count),marks:2,diff:3,src:'Book p.142 (harder)',
    prompt:`This object has a <b>back row and a front row</b> of cubes. How many cubes were used altogether? Count the hidden ones too!${stack2SVG(p)}`,
    sol:`Back row: ${p.back.join(' + ')} = ${p.back.reduce((a,b)=>a+b,0)}. Front row: ${p.front.join(' + ')} = ${p.front.reduce((a,b)=>a+b,0)}. Total: <b>${p.count}</b>.`,
    hints:['Count the back row and the front row separately.','Some back cubes hide behind front ones … trust the columns.'],pencil:true};
}};
TYPES.topView={skill:'s4',gen(fx){
  const i=(fx&&fx.i!=null)?fx.i:ri(0,STACK2.length-1); const p=STACK2[i];
