  if(sync&&typeof sync.gradePencil==='function'){
    try{ g=await sync.gradePencil({image:png,prompt:String(it.prompt).replace(/<[^>]*>/g,' '),
      expected:String(it.ans),maxMarks:it.marks,rubric:pencilRubric(it),confidenceThreshold:0.85}); }
    catch(_){ g=null; }
  }
  recordPencilAttempt(it,png,g);
  if(g&&g.correct===true){
    S.streak++;S.best=Math.max(S.best,S.streak);S.stars++;
    const won=checkBadges();
    showFB('good',`Beautiful work! 🌟 Marked correct.${won.length?'<br>🏅 New badge: <b>'+won.join(', ')+'</b>!':''}`);
  } else {
    showFB('hint','Saved for Dad to check ✏️ … your marks update once he reviews it.');
  }
  save();
  scheduleAdvance(1400);
}
function recordPencilAttempt(it,png,g){
  const correct=g&&g.correct===true?true:null; // pending review unless confidently correct
  if(correct===true) updateMastery(it.skill,true,true,hintsUsed);
  S.log.push({id:it.id,type:it.type,skill:it.skill,mode:S.cur.mode,session:S.session,
    prompt:it.prompt,ans:it.ans,user:'(drawing)',correct,firstTry:true,hints:hintsUsed,
    marks:correct===true?it.marks:0,maxMarks:it.marks,timeS:Math.round((Date.now()-T0)/1000),
    png,ts:Date.now(),pencil:true,needsParentReview:correct!==true,
    grading:g?{verdict:g.verdict,score:g.score,confidence:g.confidence,humanReview:g.humanReview,
      transcription:g.transcription,model:g.model,error:g.error||null}:{error:'unavailable'}});
  save();
}
function qToken(){ return S.cur?(S.session+":"+S.qi+":"+S.cur.mode):null; }
function scheduleAdvance(delay){ clearTimeout(advTimer); const tok=qToken(); advTimer=setTimeout(()=>{ if(!S.cur||qToken()!==tok) return; S.qi++; save(); renderQuestion(); }, delay); }
function doCheck(){ if(qLock) return;
  const it=curItem();
  if(it.input==='draw'){
    if(qLock) return;
    if(!canvasDirty()){ showFB('hint','✏️ Draw it first with your Pencil … you can do it!'); return; }
    qLock=true; disableCheck(); $('#checkBtn').style.display='none';
    gradePencilAnswer(it);
    return; }
  const user=getUserAnswer();
  if(user==null||String(user).trim()===''){ showFB('hint','✏️ Write your answer first … you can do it!'); return; }
  const ok=checkAnswer(it,user);
  const mode=S.cur.mode;
  if(mode==='diag'||mode==='mock'){ qLock=true; recordAttempt(it,user,ok,true);
    showFB('good',mode==='diag'?'Answer locked in! 🔒':'Saved ✓ … next one!');
    disableCheck(); scheduleAdvance(700); return; }
  if(ok){
    qLock=true; const first=(attemptNo===1);
    recordAttempt(it,user,true,first);
    if(first&&!hintsUsed){S.streak++;S.best=Math.max(S.best,S.streak);S.stars++;}
    else S.streak=0;
    const won=checkBadges();
    const cheers=['Brilliant! 🌟','Yes! Nailed it! 🎯','Superstar! ⭐','You got it! 🙌','Perfect! 💯','Sharp thinking! 🧠'];
    showFB('good',`${pick(cheers)}${won.length?'<br>🏅 New badge: <b>'+won.join(', ')+'</b>!':''}`);
    disableCheck();
    scheduleAdvance(1100);
  } else {
    if(attemptNo===1){ attemptNo=2; hintsUsed++;
      // Lock until the answer/choice actually changes, so rapid re-taps/Enter
      // cannot burn the second attempt on the same value (audit H-04 residual).
      qLock=true; awaitChange=String(user);
      showFB('hint',`🤔 Not quite … here's a hint:<br><b>${it.hints[0]}</b><br><span class="small">Fix your working and try again!</span>`);
    } else {
      qLock=true; recordAttempt(it,user,false,false); S.streak=0;
      S.retryQueue.push({type:it.type,reason:'auto'});
      showFB('bad',`Almost! The answer is <b>${String(it.ans).startsWith('<svg')?it.ans:esc(it.ans)}</b>.`);
      $('#fb').insertAdjacentHTML('beforeend',`<div class="sol"><b>💡 How it works:</b><br>${it.sol}</div>
        <button class="btn btn-main" onclick="S.qi++;save();renderQuestion()">Got it, next! →</button>`);
      disableCheck();
    }
  }
}
function disableCheck(){ const b=$('#checkBtn'); if(b)b.disabled=true; }
function showFB(kind,msg){ $('#fb').innerHTML=`<div class="feedback fb-${kind}">${msg}</div>`; }
function recordAttempt(it,user,correct,firstTry){
  const png=canvasDirty()?exportCanvas():null;
  updateMastery(it.skill,firstTry,correct,hintsUsed);
  S.log.push({id:it.id,type:it.type,skill:it.skill,mode:S.cur.mode,session:S.session,
    prompt:it.prompt,ans:it.ans,user:String(user),correct,firstTry,hints:hintsUsed,
    marks:correct?it.marks:0,maxMarks:it.marks,timeS:Math.round((Date.now()-T0)/1000),
    png,ts:Date.now()});
  save();
}
function finishQuiz(){ clearTimeout(clockTimer); clearTimeout(advTimer);
  const mode=S.cur?S.cur.mode:null;
  if(mode==='mock'){ const start=(S.cur&&S.cur.mockStart)||0; S.mockScore=Math.min(S.mockTotal,
    S.log.filter(a=>a.mode==='mock'&&a.correct&&(a.ts||0)>=start).reduce((t,a)=>t+a.maxMarks,0)); }  // H-04: only this mock run counts
  S.cur=null;
  const mid=Math.floor(SESSIONS[S.session].steps.length/2);
  if(!S.stretch[S.session]&&S.step===mid){
    S.stretch[S.session]=true; S.step++; save();
    render(`${header(sessionPct())}<div class="card center"><div class="emoji-big">🤸</div>
      <h2>Quick stretch?</h2><p class="big">You're doing great! Stand up, shake your arms, take three deep breaths … then come back.</p>
      <button class="btn btn-main" onclick="go()">I'm back! 💪</button>
      <button class="btn btn-ghost" onclick="go()">Skip … I'm on a roll 🔥</button></div>`);
    return; }
  nextStep();
}
</script>
<script>
"use strict";
/* ============ Apple Pencil canvas ============ */
let cv=null,cctx=null,strokes=[],curStroke=null,tool='pen';
function initCanvas(){
  cv=$('#cv'); if(!cv) return;
  const w=cv.clientWidth||700,h=cv.clientHeight||240,dpr=Math.min(2,window.devicePixelRatio||1);
  cv.width=w*dpr; cv.height=h*dpr;
  cctx=cv.getContext('2d'); cctx.scale(dpr,dpr);
  cv._w=w; cv._h=h; strokes=[]; tool='pen'; redraw();
  cv.addEventListener('pointerdown',penDown,{passive:false});
  cv.addEventListener('pointermove',penMove,{passive:false});
  cv.addEventListener('pointerup',penUp); cv.addEventListener('pointercancel',penUp);
}
function pos(e){ const r=cv.getBoundingClientRect(); return [e.clientX-r.left,e.clientY-r.top]; }
function penDown(e){ e.preventDefault(); cv.setPointerCapture(e.pointerId);
  curStroke={tool,pts:[pos(e)],w:tool==='pen'?(e.pointerType==='pen'?2.2:2.6):22}; strokes.push(curStroke); redraw(); }
function penMove(e){ if(!curStroke) return; e.preventDefault();
  const evs=e.getCoalescedEvents?e.getCoalescedEvents():[e];
  for(const ev of evs) curStroke.pts.push(pos(ev)); redraw(); }
function penUp(){ curStroke=null; }
function setTool(t){ tool=t; $('#penB').classList.toggle('on',t==='pen'); $('#erB').classList.toggle('on',t==='eraser'); }
function undoStroke(){ strokes.pop(); redraw(); }
function clearCanvas(){ strokes=[]; redraw(); }
function redraw(){ if(!cctx) return;
  cctx.fillStyle='#fff'; cctx.fillRect(0,0,cv._w,cv._h);
  cctx.strokeStyle='#eef0f6'; cctx.lineWidth=1;
  for(let y=30;y<cv._h;y+=30){cctx.beginPath();cctx.moveTo(0,y);cctx.lineTo(cv._w,y);cctx.stroke();}
  for(const s of strokes){ cctx.strokeStyle=s.tool==='pen'?'#1c2440':'#ffffff';
    cctx.lineWidth=s.w; cctx.lineCap='round'; cctx.lineJoin='round';
    cctx.beginPath(); const p=s.pts; cctx.moveTo(p[0][0],p[0][1]);
    for(let i=1;i<p.length;i++)cctx.lineTo(p[i][0],p[i][1]); cctx.stroke(); }
}
function canvasDirty(){ return strokes.some(s=>s.tool==='pen'); }
function exportCanvas(){
  const W=620,sx=W/(cv._w||W),H=Math.ceil((cv._h||240)*sx);
  const off=document.createElement('canvas'); off.width=W; off.height=H;
  const c=off.getContext('2d');
  c.fillStyle='#fff'; c.fillRect(0,0,W,H);
  for(const s of strokes){ c.strokeStyle=s.tool==='pen'?'#1c2440':'#ffffff';
    c.lineWidth=s.w*sx; c.lineCap='round'; c.lineJoin='round';
    c.beginPath(); const p=s.pts; c.moveTo(p[0][0]*sx,p[0][1]*sx);
    for(let i=1;i<p.length;i++)c.lineTo(p[i][0]*sx,p[i][1]*sx); c.stroke(); }
  return off.toDataURL('image/jpeg',0.55);
}

/* ============ submit ============ */
function sessionAttempts(n){ return S.log.filter(a=>a.session===n); }
function summaryText(n){
  const at=sessionAttempts(n); const ok=at.filter(a=>a.correct).length;
  const w=weakOrder();
  let t=`Shape Dash P2 — ${S.name}, Session ${n+1} done! ✅ ${ok}/${at.length} correct`;
  if(n===4&&S.mockScore!=null)t+=` · Mock exam: ${S.mockScore}/${S.mockTotal}`;
  t+=`. Strongest: ${SKILLS[w[w.length-1]].name}. Working on: ${SKILLS[w[0]].name}.`;
