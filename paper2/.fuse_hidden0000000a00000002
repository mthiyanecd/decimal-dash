      prompt:`Complete: &nbsp; <b>${k[1]?fmt(k[0],k[1]):k[0]} kℓ = …… mℓ</b> &nbsp; <span class="small">(go via litres!)</span>`,
      sol:`${k[1]?fmt(k[0],k[1]):k[0]} kℓ = ${k[0]*Math.pow(10,3-k[1])} ℓ = <b>${ml} mℓ</b>.`,
      hints:['kℓ → ℓ first, then ℓ → mℓ.','Two jumps of × 1000 = × 1 000 000.'],pencil:true}; }
  const g=pick([1500000,2000000,3500000]);
  return {type:'chainConv',skill:'s7',input:'text',ans:trimz(fmt(g/1000,3)),alt:[String(g/1000000).replace('.',',')],marks:2,diff:3,src:'Book p.133 Q4',
    prompt:`Complete: &nbsp; <b>${g} g = …… t</b>`,
    sol:`${g} g = ${g/1000} kg = <b>${trimz(fmt(g/1000,3))} t</b>. Two jumps of ÷ 1000.`,
    hints:['g → kg first (÷ 1000), then kg → t (÷ 1000 again).','That is ÷ 1 000 000 altogether.'],pencil:true};
}};
/* reversed faces/edges/vertices */
TYPES.fevRev={skill:'s3',gen(fx){
