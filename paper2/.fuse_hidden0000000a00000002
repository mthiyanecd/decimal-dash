  if(even){ const a=set[n/2-1],b=set[n/2]; if((a+b)%2!==0){set[n/2]=b+1;} med=(set[n/2-1]+set[n/2])/2; }
  else med=set[(n-1)/2];
  const show=shuffle(set.slice());
  return {type:'median',skill:'s8',input:'text',ans:String(med),marks:2,diff:even?3:2,src:'Book p.57–58 Q6–7',
    prompt:`Determine the <b>median</b> of this data set:<br><b style="font-size:1.2em">${show.join(' &nbsp; ')}</b>`,
