/* inverse pattern: which figure has count N? */
TYPES.pattInv={skill:'s5',gen(fx){
  const d=(fx&&fx.d)||pick([2,3,4,5]); const c=pick([0,1,2,3]);
  const k=ri(8,20); const N=d*k+c;
  const val=n=>d*n+c;
  return {type:'pattInv',skill:'s5',input:'text',ans:String(k),marks:2,diff:3,src:'Book p.90 Q4 (reversed)',
    prompt:`A pattern follows the rule: number of dots = figure number × ${d}${c?' + '+c:''}.<br>
     <b>Figure 1: ${val(1)} &nbsp; Figure 2: ${val(2)} &nbsp; Figure 3: ${val(3)}</b> …<br>Which <b>figure number</b> has <b>${N}</b> dots?`,
    sol:`Work backwards: ${N}${c?' − '+c+' = '+(N-c):''}, then ÷ ${d} = <b>${k}</b>. Check: ${d} × ${k}${c?' + '+c:''} = ${N} ✓`,
    hints:[c?`First subtract the ${c}, then divide by ${d}.`:`Divide by ${d}.`,'Undo the rule in reverse order.'],pencil:true};
}};
