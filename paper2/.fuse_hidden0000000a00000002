/* ============ answer checking ============ */
function stripUnits(s){ return String(s).replace(/(kg|km|kℓ|kl|mℓ|ml|litres?|liters?|grams?|tons?|g|m|t|ℓ|l|r)(?![a-z0-9])/gi,'')
  .replace(/[Rr]\s*(?=\d)/,'').trim(); }
function checkAnswer(item,user){
  if(item.input==='choice'||item.input==='compare') return user===item.ans;
  let u=String(user||'').trim(); if(!u) return false;
  if(item.exact){ const norm=x=>x.replace(/\s+/g,'').replace('.',','); return norm(u)===norm(item.ans); }
  const list=[item.ans].concat(item.alt||[]);
  /* text answers that are words (mode names, learner names, "no", "opposite" …) */
  const uw=u.toLowerCase().replace(/\s+/g,' ');
  if(list.some(a=>String(a).toLowerCase()===uw)) return true;
  u=stripUnits(u);
  const un=parseNum(u); if(un==null) return false;
  return list.some(a=>{const an=parseNum(stripUnits(String(a))); return an!=null&&numEq(un,an);});
}

