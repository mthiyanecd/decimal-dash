<script>
"use strict";
/* ============ state ============ */
const DEFAULT={name:'',pin:'',session:0,step:0,qi:0,cur:null,log:[],retryQueue:[],
  mastery:{s1:50,s2:50,s3:50,s4:50,s5:50,s6:50,s7:50,s8:50},
  streak:0,best:0,badges:[],stars:0,stretch:[false,false,false,false,false,false,false,false,false],
  mockScore:null,mockTotal:40,done:[false,false,false,false,false,false,false,false,false],overrides:{},comments:{},
  sessionSubmissions:{},schemaVersion:1};
const SCHEMA=1;
let S=load();
function cleanName(s){ return String(s||'').trim().replace(/[\s\-−–—]+$/,''); }
function hydrateState(saved){
  const base=JSON.parse(JSON.stringify(DEFAULT));
  if(saved&&typeof saved==='object'){
    for(const k in base){ const dv=base[k], sv=saved[k]; if(sv===undefined) continue;
      if(Array.isArray(dv)){ if(Array.isArray(sv)){ const out=dv.slice(); for(let i=0;i<sv.length;i++) out[i]=sv[i]; base[k]=out; } }
      else if(dv&&typeof dv==='object'){ base[k]=Object.assign({},dv,(sv&&typeof sv==='object')?sv:{}); }
      else base[k]=sv; }
    if(base.mastery&&DEFAULT.mastery){ for(const sk in DEFAULT.mastery){ let v=Number(base.mastery[sk]); if(!isFinite(v)) v=DEFAULT.mastery[sk]; base.mastery[sk]=Math.max(0,Math.min(100,v)); } }
  }
  base.name=cleanName(base.name); base.schemaVersion=SCHEMA; return base;
}
function load(){ try{ const j=localStorage.getItem('ddp2'); if(j){ const o=hydrateState(JSON.parse(j)); return o; } }catch(e){}
  return JSON.parse(JSON.stringify(DEFAULT)); }
let saveFailed=false;
function notifySaveFailed(){ try{ let b=document.getElementById('saveWarn'); if(!b){ b=document.createElement('div'); b.id='saveWarn'; b.style.cssText='position:fixed;left:8px;right:8px;bottom:8px;z-index:99999;background:#c23a4b;color:#fff;padding:10px 12px;border-radius:12px;font:14px -apple-system,sans-serif;text-align:center'; document.body.appendChild(b);} b.textContent='⚠️ Progress could not be saved on this device. Please tell Dad.'; }catch(_){} }
function save(){ try{ localStorage.setItem('ddp2',JSON.stringify(S)); saveFailed=false; return true; }
  catch(e){ const quota=e&&(e.name==='QuotaExceededError'||e.code===22||e.code===1014);
    if(!quota){ saveFailed=true; console.warn('[save] non-quota failure',e); notifySaveFailed(); return false; }
    let _n=0; for(const a of S.log){ if(a.png){a.png=null;a.pngDropped=true;} if(++_n%10===0 && JSON.stringify(S).length<4000000) break; }
    try{ localStorage.setItem('ddp2',JSON.stringify(S)); saveFailed=false; return true; }
    catch(e2){ saveFailed=true; console.warn('[save] still failing after trim',e2); notifySaveFailed(); return false; } } }

/* ============ adaptive ============ */
function weakOrder(){ return Object.keys(SKILLS).sort((a,b)=>
  (S.mastery[a]-(SKILLS[a].essential?15:0))-(S.mastery[b]-(SKILLS[b].essential?15:0))); }
function pickPracticeItems(n,cap){
  const w=weakOrder(); const pool=[w[0],w[0],w[1],w[1],w[2],w[3]];
  const items=[]; for(let i=0;i<n;i++) items.push(makeFromSkill(pool[i%pool.length],cap,false));
  return shuffle(items); }
function masteredSkills(){ return Object.keys(SKILLS).filter(s=>S.mastery[s]>=70); }
function confidenceItems(n){
  const ms=masteredSkills(); const src=ms.length?ms:weakOrder().slice(-3);
  const items=[];for(let i=0;i<n;i++)items.push(makeFromSkill(pick(src),2,false));
  return items; }
function updateMastery(skill,firstTry,correct,hints){
  let d; if(correct&&firstTry&&!hints)d=14; else if(correct&&firstTry)d=8; else if(correct)d=5; else d=-12;
  S.mastery[skill]=Math.max(0,Math.min(100,S.mastery[skill]+d)); }

