<script>
"use strict";
/* ============ SVG helpers ============ */
let SEQ=0;
function newId(t){const r=(self.crypto&&crypto.randomUUID)?crypto.randomUUID().slice(0,8):(Date.now().toString(36)+Math.random().toString(36).slice(2,6));return t+"-"+(++SEQ)+"-"+r;}
function randV(dp,maxWhole){ const w=ri(0,maxWhole); let f;
  do{ f=ri(1,Math.pow(10,dp)-1); }while(f%10===0);
  return w*Math.pow(10,dp)+f; }
const SW='stroke="#2b2350" stroke-width="2.5" fill="none" stroke-linejoin="round"';
function svgWrap(w,h,inner,mw){return `<svg viewBox="0 0 ${w} ${h}" xmlns="http://www.w3.org/2000/svg" style="max-width:${mw||220}px;display:block;margin:10px 0">${inner}</svg>`;}
function polyPts(n,irr){ const pts=[];
  for(let i=0;i<n;i++){ const a=-Math.PI/2+i*2*Math.PI/n;
    const r=irr?45+ri(-18,18):60;
    pts.push([(75+r*Math.cos(a)).toFixed(1),(78+r*Math.sin(a)).toFixed(1)]);}
  return pts; }
function polySVG(n,irr){ const p=polyPts(n,irr);
  return svgWrap(150,156,`<polygon points="${p.map(q=>q.join(',')).join(' ')}" ${SW} fill="#efeaff"/>`,170); }
const QUADS={
 square:[[25,20],[115,20],[115,110],[25,110]],
 rectangle:[[10,40],[140,40],[140,110],[10,110]],
 parallelogram:[[35,35],[140,35],[105,110],[0,110]],
 rhombus:[[75,15],[122,72],[75,129],[28,72]],
 trapezium:[[40,35],[110,35],[140,110],[10,110]],
 kite:[[75,10],[112,62],[75,134],[38,62]]};
function quadSVG(t){ const p=QUADS[t];
  return svgWrap(150,145,`<polygon points="${p.map(q=>q.join(',')).join(' ')}" ${SW} fill="#e8f7f4"/>`,170); }
function angleSVG(deg){ const cx=40,cy=95,L=95; const a=-deg*Math.PI/180;
  const x2=cx+L*Math.cos(a), y2=cy+L*Math.sin(a);
  const r=26, large=deg>180?1:0;
  const ax=cx+r*Math.cos(0), ay=cy+r*Math.sin(0);
  const bx=cx+r*Math.cos(a), by=cy+r*Math.sin(a);
  return svgWrap(190,120,`<line x1="${cx}" y1="${cy}" x2="${cx+L}" y2="${cy}" ${SW}/>
   <line x1="${cx}" y1="${cy}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" ${SW}/>
   <path d="M ${ax} ${ay} A ${r} ${r} 0 ${large} 0 ${bx.toFixed(1)} ${by.toFixed(1)}" stroke="#e0485a" stroke-width="2" fill="none"/>`,210);}
function cubeAt(x,y,s){ const d=Math.round(s*0.45);
  return `<polygon points="${x},${y} ${x+s},${y} ${x+s},${y+s} ${x},${y+s}" ${SW} fill="#f6f4ff"/>
   <polygon points="${x},${y} ${x+d},${y-d} ${x+s+d},${y-d} ${x+s},${y}" ${SW} fill="#e2dbfa"/>
   <polygon points="${x+s},${y} ${x+s+d},${y-d} ${x+s+d},${y+s-d} ${x+s},${y+s}" ${SW} fill="#cfc5f2"/>`;}
function stackSVG(heights){ const s=30; let out='';
  for(let c=0;c<heights.length;c++)
    for(let h=0;h<heights[c];h++)
      out+=cubeAt(15+c*s,120-s-h*s,s);
  return svgWrap(15+heights.length*s+25,140,out,200);}
function gridViewSVG(cells,label){ const s=24; let out='';
  const maxx=Math.max(...cells.map(c=>c[0]))+1, maxy=Math.max(...cells.map(c=>c[1]))+1;
  for(const [x,y] of cells) out+=`<rect x="${6+x*s}" y="${6+(maxy-1-y)*s}" width="${s}" height="${s}" ${SW} fill="#efeaff"/>`;
  return `<svg viewBox="0 0 ${12+maxx*s} ${12+maxy*s}" xmlns="http://www.w3.org/2000/svg" style="width:${12+maxx*s}px;vertical-align:middle">${out}</svg>`;}
function frontCells(heights){ const cells=[];
  heights.forEach((h,x)=>{for(let y=0;y<h;y++)cells.push([x,y]);}); return cells; }
function letterSVG(ch){ return svgWrap(110,120,`<text x="55" y="92" font-size="95" font-weight="800" text-anchor="middle" font-family="Helvetica,Arial" fill="#2b2350">${ch}</text>`,120);}
function tallySVG(n){ const g=Math.floor(n/5), r=n%5; let out=''; let x=12;
  for(let i=0;i<g;i++){ for(let k=0;k<4;k++){out+=`<line x1="${x+k*9}" y1="12" x2="${x+k*9}" y2="52" ${SW}/>`;}
    out+=`<line x1="${x-5}" y1="45" x2="${x+31}" y2="16" ${SW}/>`; x+=48; }
  for(let k=0;k<r;k++){out+=`<line x1="${x+k*9}" y1="12" x2="${x+k*9}" y2="52" ${SW}/>`;}
  return svgWrap(x+r*9+12,62,out,260);}
function pictoSVG(full,half){ let out=''; let x=22;
  for(let i=0;i<full;i++){out+=`<circle cx="${x}" cy="30" r="15" ${SW} fill="#ffe9a8"/>`;x+=40;}
  if(half){out+=`<path d="M ${x} 15 A 15 15 0 0 0 ${x} 45 Z" ${SW} fill="#ffe9a8"/>`;x+=40;}
  return `<svg viewBox="0 0 ${x} 60" xmlns="http://www.w3.org/2000/svg" style="height:44px;vertical-align:middle">${out}</svg>`;}
function barSVG(labels,vals,step){ const W=380,H=230,x0=46,y0=190,bw=Math.min(46,(W-x0-20)/vals.length-14);
  const mx=Math.ceil(Math.max(...vals)/step)*step;
  let out=`<line x1="${x0}" y1="${y0}" x2="${W-8}" y2="${y0}" ${SW}/><line x1="${x0}" y1="${y0}" x2="${x0}" y2="14" ${SW}/>`;
  for(let v=0;v<=mx;v+=step){ const y=y0-(y0-20)*v/mx;
    out+=`<line x1="${x0-4}" y1="${y}" x2="${x0}" y2="${y}" ${SW}/><text x="${x0-8}" y="${y+4}" font-size="12" text-anchor="end" fill="#2b2350">${v}</text>
      <line x1="${x0}" y1="${y}" x2="${W-8}" y2="${y}" stroke="#eee9fb" stroke-width="1"/>`;}
  vals.forEach((v,i)=>{ const x=x0+16+i*((W-x0-30)/vals.length); const h=(y0-20)*v/mx;
    out+=`<rect x="${x}" y="${y0-h}" width="${bw}" height="${h}" fill="#6c4ce0" opacity="0.85"/>
      <text x="${x+bw/2}" y="${y0+16}" font-size="12" text-anchor="middle" fill="#2b2350">${labels[i]}</text>`;});
  return svgWrap(W,H,out,420);}
function dblBarSVG(labels,v1,v2,step,k1,k2){ const W=400,H=250,x0=46,y0=190,bw=16;
  const mx=Math.ceil(Math.max(...v1,...v2)/step)*step;
  let out=`<line x1="${x0}" y1="${y0}" x2="${W-8}" y2="${y0}" ${SW}/><line x1="${x0}" y1="${y0}" x2="${x0}" y2="14" ${SW}/>`;
  for(let v=0;v<=mx;v+=step){ const y=y0-(y0-20)*v/mx;
