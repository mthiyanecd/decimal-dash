/* chain conversions (star) */
TYPES.chainConv={skill:'s7',gen(fx){
  const kind=(fx&&fx.kind)||pick(['tg','klml','gkt']);
  if(kind==='tg'){ const t=pick([[1,0],[25,1],[3,0],[15,1]]);
    const g=t[0]*Math.pow(10,6-t[1]);
    return {type:'chainConv',skill:'s7',input:'text',ans:String(g),marks:2,diff:3,src:'Book p.133 Q4c *',
      prompt:`Complete: &nbsp; <b>${t[1]?fmt(t[0],t[1]):t[0]} t = …… g</b> &nbsp; <span class="small">(go via kilograms!)</span>`,
      sol:`${t[1]?fmt(t[0],t[1]):t[0]} t = ${t[0]*Math.pow(10,3-t[1])} kg = <b>${g} g</b>. Two jumps of × 1000.`,
      hints:['Tons → kg first (× 1000), then kg → g (× 1000 again).','That is × 1 000 000 altogether.'],pencil:true}; }
  if(kind==='klml'){ const k=pick([[1,0],[5,1],[2,0]]);
