   <textarea class="note" id="cmt">${esc(S.comments[a.id]||'')}</textarea>
   <button class="btn btn-soft" onclick="S.comments['${a.id}']=$('#cmt').value;save();alert('Comment saved.')">Save comment</button>
  </div>`);
}
function makeCode(skill){
  const ts=shuffle(SKILL_TYPES[skill].slice()).slice(0,3);
  $('#codeOut').innerHTML=`<div class="feedback fb-good">Send her this code: <b>DD-${ts.join('.')}</b><br>
    <a class="btn btn-teal linkbtn" style="margin-top:8px" href="sms:&body=${encodeURIComponent('Here is a bonus round for you! 🎁 Open Shape Dash, tap "code from Dad" and type: DD-'+ts.join('.'))}">Send by iMessage</a></div>`;
}
// Strict per-field import validation + in-package dedup (audit M-03/C-02).
const IMPORT_ID=/^[A-Za-z0-9._:-]{1,80}$/;
function normAttempt(raw){
  if(!raw||typeof raw!=='object')throw 0;
  if(!IMPORT_ID.test(String(raw.id)))throw 0;
  if(!TYPES[raw.type])throw 0;
  if(!SKILLS[raw.skill])throw 0;
  const c=raw.correct===true?true:(raw.correct===false?false:null);
  return {id:String(raw.id),type:raw.type,skill:raw.skill,mode:String(raw.mode||'').slice(0,24),
    session:Number.isInteger(raw.session)?raw.session:0,
    user:String(raw.user==null?'':raw.user).slice(0,200),correct:c,
    marks:Number.isFinite(raw.marks)?raw.marks:0,maxMarks:Number.isFinite(raw.maxMarks)?raw.maxMarks:0,
    ts:Number.isFinite(raw.ts)?raw.ts:Date.now(),
    hints:Number.isFinite(raw.hints)?raw.hints:0,timeS:Number.isFinite(raw.timeS)?raw.timeS:0,
    ans:String(raw.ans==null?'':raw.ans).slice(0,200),
    prompt:esc(String(raw.promptText||raw.prompt||'').replace(/<[^>]*>/g,' ').slice(0,400)),
    pencil:raw.pencil===true,needsParentReview:raw.needsParentReview===true,imported:true};
}
function importFile(){
  const f=$('#impF').files[0]; if(!f){alert('Choose a file first.');return;}
  if(f.size>2000000){$('#ioMsg').innerHTML=`<div class="feedback fb-bad">That file is too large to import.</div>`;return;}
  const r=new FileReader();
  r.onload=()=>{ try{
    const p=JSON.parse(r.result);
    if(p&&p.kind==='full-backup'&&p.app==='ShapeDashP2'&&p.state){
      if(!confirm('Restore a full backup? This replaces ALL current progress on this iPad.'))return;
      localStorage.setItem('ddp2',JSON.stringify(p.state)); location.reload(); return;
    }
    if(!p||p.app!=='ShapeDashP2'||!Array.isArray(p.attempts)||p.attempts.length>2000)throw 0;
    const seen=new Set(S.log.map(a=>a.id)); let n=0;
    for(const raw of p.attempts){ let a; try{a=normAttempt(raw);}catch(_){continue;} if(seen.has(a.id))continue; seen.add(a.id); S.log.push(a); n++; }
    if(p.learner&&!S.name)S.name=cleanName(p.learner);
    save(); $('#ioMsg').innerHTML=`<div class="feedback fb-good">Imported ${n} new answers from ${esc(p.learner||'learner')}, session ${esc(p.session)}.</div>`;
   }catch(e){ $('#ioMsg').innerHTML=`<div class="feedback fb-bad">That file doesn't look like a Shape Dash session.</div>`; } };
  r.readAsText(f);
}
function exportAll(){
  const backup={app:'ShapeDashP2',kind:'full-backup',schemaVersion:SCHEMA,exportedAt:new Date().toISOString(),state:S};
  const blob=new Blob([JSON.stringify(backup)],{type:'application/json'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a'); a.href=url;
  a.download=`ShapeDash_P2_FullBackup_${new Date().toISOString().slice(0,10)}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),4000);
  $('#ioMsg').innerHTML=`<div class="feedback fb-good">Backup downloaded to your iCloud folder ✓</div>`;
}

/* ============ boot ============ */
go();
