  return {type:'barTrend',skill:'s8',input:'choice',choices:shuffle([truth,false1,false2]),ans:truth,marks:2,diff:3,src:'Book p.56 Q4a',
    prompt:`Study the bar graph.<br>${barSVG(BARNAMES,vals,step)}<br>Which statement is <b>true</b>?`,
