      <span class="pill ${ok?'g':'b'}">${ok?'correct':'incorrect'}${ov!=null?' (overridden)':''}</span></p>
   ${a.png?`<p class="small">Her handwritten working:</p><img class="hw" src="${a.png}">`:'<p class="small">No handwriting captured for this one.</p>'}
   <div class="rowflex" style="margin-top:10px">
     <button class="tool" onclick="S.overrides['${a.id}']=true;save();renderPDetail(${i})">Override: correct ✓</button>
     <button class="tool" onclick="S.overrides['${a.id}']=false;save();renderPDetail(${i})">Override: incorrect ✗</button>
