}
function getUserAnswer(){ const it=curItem();
  if(it.input==='text'){ const el=$('#ansIn'); return el?el.value:''; }
  return selVal; }
// F-03: automated Pencil grading (no learner self-marking). Locks the question,
// captures the real canvas JPEG, grades with a per-question rubric, and only
// auto-marks correct when the model is confident and no human review is needed.
function pencilRubric(it){
  const half=Math.max(1,Math.floor(it.marks/2));
  return {maxMarks:it.marks,expected:String(it.ans),model:it.model||it.sol||'',
    criteria:[
      {label:'Correct concept and method',marks:half,misconceptions:'reversed shape, wrong property'},
      {label:'Accurate result with correct labels and units',marks:it.marks-half,equivalents:'accept equivalent forms',partialCredit:true}
    ]};
}
async function gradePencilAnswer(it){
  const png=exportCanvas();
