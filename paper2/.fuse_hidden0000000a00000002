     <button class="btn btn-soft" onclick="const n=cleanName($('#setName').value);if(n)S.name=n;
       const p=$('#setPin').value; if(p.length===4)S.pin=p; save(); alert('Saved.')">Save</button>
      <button class="btn btn-ghost" onclick="if(confirm('Reset EVERYTHING? All progress will be lost.')){localStorage.removeItem('ddp2');location.reload();}">⚠️ Reset the whole app</button>`;
  }
  render(`${header(0)}<div class="card">${pTabs(tab)}${body}</div>`);
}
function renderPDetail(i){
  const a=S.log[i]; if(!a){renderParent('q');return;}
  const ov=S.overrides[a.id]; const ok=ov!=null?ov:a.correct;
  render(`${header(0)}<div class="card">${pTabs('q')}
