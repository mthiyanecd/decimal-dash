/* bar graph: which statement is true? */
TYPES.barTrend={skill:'s8',gen(){
  const step=pick([5,10]); const vals=BARNAMES.map(()=>ri(2,9)*step);
  if(new Set(vals).size<5) return TYPES.barTrend.gen();
