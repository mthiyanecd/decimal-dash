    <a class="btn btn-teal linkbtn" href="sms:&body=${encodeURIComponent(summaryText(n))}">💬 Tell Dad on iMessage</a>
    <button class="btn btn-main" onclick="closeSession(${n})">${final?'Finish! 🌟':'Done for now! 👋'}</button>
    <button class="btn btn-soft" onclick="exportSession(${n})">⬇️ Export backup (.json)</button></div>`);
  submitCurrentSession(n);
}
function sessionSubmitRec(n){
  if(!S.sessionSubmissions||typeof S.sessionSubmissions!=='object') S.sessionSubmissions={};
  let rec=S.sessionSubmissions[n];
  if(!rec){ rec={id:(self.crypto&&crypto.randomUUID?crypto.randomUUID():'sub-'+Date.now()+'-'+Math.random().toString(36).slice(2)),created:Date.now(),status:'pending'}; S.sessionSubmissions[n]=rec; save(); }
  return rec;
}
async function submitCurrentSession(n){
  const rec=sessionSubmitRec(n); const el=$('#syncStatus'); const sync=window.StudyDashSync;
  const at=sessionAttempts(n);
  if(!sync||typeof sync.submitSession!=='function'){ if(el)el.textContent='Saved on this iPad ✓ (open online to sync to Dad)'; return; }
  if(el)el.textContent='Saved on iPad · Syncing…';
  try{
    const env={session:n,learner:S.name,attempts:at.length,correct:at.filter(a=>a.correct===true).length,summary:summaryText(n)};
    const r=await sync.submitSession(rec.id,env);
    rec.status=r.status; save();
    if(el)el.textContent=r.status==='synced'?'Synced with Dad ✓':'Saved offline · will retry automatically';
  }catch(e){ if(el)el.textContent='Saved offline · will retry automatically'; }
}
function exportSession(n){
  const blob=new Blob([buildPackage(n)],{type:'application/json'});
  const url=URL.createObjectURL(blob); const a=document.createElement('a');
  a.href=url; a.download=`ShapeDash_P2_Session${n+1}_${new Date().toISOString().slice(0,10)}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),4000);
}
function closeSession(n){
  S.done[n]=true; checkBadges(); S.session=n+1; S.step=0; S.cur=null; S.qi=0; save(); go();
}

/* ============ retry code from Dad ============ */
