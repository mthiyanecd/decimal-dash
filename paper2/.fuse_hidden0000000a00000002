    <div id="fb"></div>
    <button class="btn btn-teal" id="checkBtn" onclick="doCheck()">${it.input==='draw'?"I'm done ✏️":'Check ✓'}</button>
   </div>`);
  initCanvas();
  if(mode==='mock') tickClock();
  const ai=$('#ansIn'); if(ai){ai.addEventListener('input',e=>maybeUnlock(e.target.value)); ai.addEventListener('keydown',e=>{if(e.key==='Enter')doCheck();});}
}
function selChoice(btn){
  const i=+btn.getAttribute('data-i');
  selVal=i>=0?String(curItem().choices[i]):btn.getAttribute('data-v');
  maybeUnlock(selVal);
  document.querySelectorAll('.choice').forEach(b=>b.classList.remove('sel')); btn.classList.add('sel'); }
function tickClock(){ clearTimeout(clockTimer);
  const el=$('#clock'); if(!el||!S.cur||!S.cur.deadline) return;
  const left=Math.max(0,S.cur.deadline-Date.now());
  const m=Math.floor(left/60000),s=Math.floor(left%60000/1000);
  el.textContent=`⏱ ${m}:${String(s).padStart(2,'0')}`;
  if(left<5*60*1000) el.classList.add('low');
