let T0=0, hintsUsed=0, attemptNo=1, selVal=null, drawRevealed=false;
let clockTimer=null, advTimer=null, qLock=false, awaitChange=null;  // owned timers + one-shot submit lock (H-04)
// Release the first-wrong lock once the learner actually changes their answer.
function maybeUnlock(v){ if(awaitChange!=null && String(v)!==awaitChange){ qLock=false; awaitChange=null; } }
function startQuiz(st){
  if(!S.cur){
    let items;
    if(st.make) items=st.make();
    else if(st.mode==='retry'){
      const q=S.retryQueue.splice(0,6);
      items=q.length?q.map(r=>makeItem(r.type)):pickPracticeItems(3);
    }
    else if(st.mode==='corrections'){
      const wrong=S.log.filter(a=>a.mode==='mock'&&!a.correct);
      items=wrong.length?wrong.slice(0,8).map(a=>makeItem(a.type)):confidenceItems(3);
    }
    else if(st.mode==='confidence') items=confidenceItems(st.n||5);
    else if(st.weak!=null){ const skill=S['lessonSkill'+st.weak]||weakOrder()[st.weak];
      items=[];for(let i=0;i<(st.n||4);i++)items.push(makeFromSkill(skill,null,false)); }
    else items=pickPracticeItems(st.n||6);
    S.cur={mode:st.mode,items:items,started:Date.now()};
    if(st.mode==='mock'){S.cur.deadline=Date.now()+40*60*1000;S.cur.mockStart=Date.now();}
    S.qi=0; save();
  }
  renderQuestion();
}
